module Prosody
  type error_category = :transient | :permanent | :terminal

  class ResponseError < Error
  end

  class HandlerResponseError < ResponseError
    attr_reader category: error_category
    attr_reader handler_message: String
    def initialize: (category: error_category, handler_message: String, message: String) -> void
  end

  class ResponseTimeoutError < ResponseError
  end

  class ResponseFormatMismatchError < ResponseError
  end

  class MalformedResponseError < ResponseError
  end

  type request_result[Value] = Value | ResponseError
  type native_request = {
    topic: String,
    key: String,
    payload: json_value,
    subsystems: Array[String],
    timeout: Integer | Float,
    headers: Hash[String, String]
  }

  class Client
    def request: (
      String topic,
      String key,
      json_value payload,
      Array[String] subsystems,
      (Integer | Float) timeout,
      ?headers: Hash[String, String]
    ) -> Array[request_result[json_value]]

    private

    def native_request: (native_request request) -> Array[request_result[json_value]]
  end
end
